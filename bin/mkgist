#!/bin/sh
# Creates a secret Gist on GitHub, and turns the given directory (default: the
# current one) into a checkout of that Gist. The directory is created if it
# doesn't exist. Files already in the directory are left alone; they are not
# added or committed.
set -e

mkdir -p "${1:-.}"
cd "${1:-.}"
if [ -e .git ]; then
  echo "$(pwd) is already a Git checkout."
  exit 1
fi

# A Gist can't be created empty, so create it with a placeholder file.
placeholder="mkgist_placeholder.txt"
url=$(echo "Placeholder for a new Gist." | gh gist create --filename "$placeholder" -)

clone=$(mktemp -d)
gh gist clone "${url##*/}" "$clone/gist"
mv "$clone/gist/.git" .
rm -rf "$clone"

# Now that the Gist exists, the placeholder file isn't needed.
git rm --quiet --cached "$placeholder"
git commit --quiet --message "Remove placeholder file"
git push --quiet

echo "$url"
